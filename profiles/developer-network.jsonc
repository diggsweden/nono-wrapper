// Shared online defaults. Authentication remains the agent/user's choice.
// Prefer concrete hosts so exact user endpoint rules can replace defaults.
{
  "meta": {
    "name": "developer-network",
    "version": "0.8.0",
    "description": "Developer forges, documentation/licensing references, Go module proxy and vulnerability-data services"
  },
  "environment": { "allow_vars": ["GIT_SSH_COMMAND", "GIT_SSH", "GIT_SSH_VARIANT"] },
  "network": {
    "allow_domain": [
      // Alphabetical by hostname. Login endpoint rules stay agent-specific.
      // Includes approved community mirrors and unofficial Node builds;
      // download access never replaces artifact signature/checksum validation.
      "*.oaiusercontent.com",
      "12factor.net",
      "altssh.gitlab.com",
      "api.deps.dev",
      "api.github.com",
      "api.openai.com",
      "api.osv.dev",
      "api.reuse.software",
      "api.stackexchange.com",
      "appstoreconnect.apple.com",
      "archive.ubuntu.com",
      "auth.docker.io",
      "brailleinstitute.org",
      "central.sonatype.com",
      "check.trivy.dev",
      "codeberg.org",
      "codefloe.com",
      "codeload.github.com",
      "conventionalcommits.org",
      "creativecommons.org",
      "cyclonedx.org",
      "deb.debian.org",
      "developer.android.com",
      "developercertificate.org",
      "developers.google.com",
      "django.readthedocs.org",
      "dl.google.com",
      "docs.gitea.com",
      "docs.github.com",
      "docs.gitlab.com",
      "docs.itiquette.org",
      "docs.python.org",
      "docs.sigstore.dev",
      "docs.translatehouse.org",
      "downloads.gradle.org",
      "en.wikipedia.org",
      "endevco.github.io",
      "eupl.eu",
      "files.pythonhosted.org",
      "forgejo.org",
      "fs.liujiacai.net",
      "garagehq.deuxfleurs.fr",
      "gcr.io",
      "ghcr.io",
      "git-scm.com",
      "github.com",
      "gitlab.com",
      "go.dev",
      "grafana.com",
      "grype.anchore.io",
      "img.shields.io",
      "index.crates.io",
      "index.docker.io",
      "just.systems",
      "keepachangelog.com",
      "kics.io",
      "mirror.gcr.io",
      "mise-versions.jdx.dev",
      "mise.jdx.dev",
      "nodejs.org",
      "npm.jsr.io",
      "objects.githubusercontent.com",
      "openbao.org",
      "opentelemetry.io",
      "oss-fuzz-build-logs.storage.googleapis.com",
      "pkg-containers.githubusercontent.com",
      "pkg.alexrp.com",
      "pkg.earth",
      "pkg.hexops.org",
      "play.google.com",
      "prometheus.io",
      "proxy.golang.org",
      "pypi.org",
      "raw.githubusercontent.com",
      "registry-1.docker.io",
      "registry.fedoraproject.org",
      "registry.npmjs.org",
      "registry.opensuse.org",
      "release-assets.githubusercontent.com",
      "reneefrench.blogspot.com",
      "reuse.software",
      "sembr.org",
      "semgrep.dev",
      "semver.org",
      "services.gradle.org",
      "slsa.dev",
      "spdx.github.io",
      "ssh.github.com",
      "stackoverflow.com",
      "static.crates.io",
      "static.rust-lang.org",
