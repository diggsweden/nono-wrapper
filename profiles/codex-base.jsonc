  "extends": ["nolabs-ai/codex", "agent-policy"],
  "meta": {
    "name": "codex-base",
    "version": "0.2.0",
    "description": "Official Codex pack with shared policy overrides"
  },
  "environment": { "allow_vars": ["CODEX_HOME"] }
}
