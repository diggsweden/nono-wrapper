// OpenAI / ChatGPT account login and token refresh. The pinned OpenCode
// browser flow listens on TCP port 1455. Its model catalogue has a GET rule.
// Endpoint rules make nono intercept TLS and refuse other methods and paths
// over HTTPS. Plain HTTP to a listed host is not covered by them.
{
  "extends": ["opencode-base", "developer-network"],
  "meta": { "name": "opencode-chatgpt", "version": "0.3.0", "description": "OpenCode ChatGPT login with developer network defaults" },
  "network": {
    "allow_domain": [
      {
        "domain": "models.opencode.ai",
        "endpoints": [{ "method": "GET", "path": "/api.json" }]
      },
      {
        "domain": "chatgpt.com",
        "endpoints": [{ "method": "POST", "path": "/backend-api/codex/responses" }]
      },
      {
        // Browser and device-code login, then token refresh.
        "domain": "auth.openai.com",
        "endpoints": [
          { "method": "POST", "path": "/oauth/token" },
          { "method": "POST", "path": "/api/accounts/deviceauth/usercode" },
          { "method": "POST", "path": "/api/accounts/deviceauth/token" }
        ]
      }
    ],
    "listen_port": [1455]
  }
}
