// OpenAI / ChatGPT account login and token refresh. The pinned OpenCode
// 2.2.5 uses ChatGPT token sharing and a dynamic browser callback port.
// The launcher supplies private loopback on Linux. Host browser callbacks
// need the explicit login setup in docs/opencode-2-evaluation.md.
// Endpoint rules make nono intercept TLS and refuse other methods and paths
// over HTTPS. Plain HTTP to a listed host is not covered by them.
{
  "extends": ["opencode-base", "developer-network"],
  "meta": { "name": "opencode-chatgpt", "version": "0.4.0", "description": "OpenCode 2 ChatGPT login with developer network defaults" },
  "network": {
    "allow_domain": [
      {
        "domain": "models.opencode.ai",
        "endpoints": [{ "method": "GET", "path": "/api.json" }]
      },
      {
        "domain": "chatgpt.com",
        "endpoints": [{ "method": "POST", "path": "/backend-api/codex/responses" }]
      },
      {
        // OpenCode 2.2.5 token sharing and ID-token verification.
        "domain": "auth.openai.com",
        "endpoints": [
          { "method": "POST", "path": "/api/accounts/oauth/token" },
          { "method": "GET", "path": "/.well-known/jwks.json" }
        ]
      }
    ]
  }
}
